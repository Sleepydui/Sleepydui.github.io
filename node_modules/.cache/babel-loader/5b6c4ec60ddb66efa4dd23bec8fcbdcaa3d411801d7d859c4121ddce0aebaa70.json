tom: 0.625rem; }\n.site-logo { height: 2.875rem; width: auto; display: block; }\n.site-nav ul { margin: 0; padding: 0; list-style: none; display: flex; gap: 1.75rem; }\n.site-nav a { font-family: \"Merriweather\", Georgia, serif; font-weight: 400; color: hsl(0 0% 27%); font-size: 1.125rem; }\n.site-nav a[aria-selected=\"true\"] { color: #000; }\n\n@media (max-width: 48rem) {\n  .header-inner { flex-direction: column; gap: 1rem; }\n  .site-nav ul { flex-wrap: wrap; justify-content: center; gap: 1rem; }\n}\n</style>\n\n\n"],"mappings":";;;;;;;;;;;;;AAiBA,eAAe;EACbA,IAAI,EAAE,YAAY;EAClBC,IAAG,WAAAA,KAAA,EAAK;IACN,OAAO;MAAEC,MAAM,EAAE,OAAO;MAAEC,OAAO,EAAE;IAAG;EACxC,CAAC;EACDC,OAAO,WAAAA,QAAA,EAAG;IAAA,IAAAC,KAAA;IACR,IAAI,CAACF,OAAM,GAAI,IAAIG,GAAG,CAAC,mBAAmB,EAAEC,MAAM,CAACC,IAAI,CAACC,GAAG,CAAC,CAACC,IAAG;IAChE,IAAMC,KAAI,GAAIC,KAAK,CAACC,IAAI,CAACC,QAAQ,CAACC,gBAAgB,CAAC,WAAW,CAAC;IAC/D,IAAMC,aAAY,GAAI,SAAhBA,aAAYA,CAAKC,EAAE,EAAK;MAC5B,IAAMC,MAAK,GAAIJ,QAAQ,CAACK,cAAc,CAACF,EAAE;MACzC,IAAI,CAACC,MAAM,EAAE;MACbA,MAAM,CAACE,cAAc,CAAC;QAAEC,QAAQ,EAAE,QAAQ;QAAEC,KAAK,EAAE;MAAQ,CAAC;MAC5DjB,KAAI,CAACH,MAAK,GAAIe,EAAC;MACfM,QAAQ,CAACC,IAAG,GAAIP,EAAC;IACnB;IACAN,KAAK,CAACc,OAAO,CAAC,UAAAC,CAAA;MAAA,OAAKA,CAAC,CAACC,gBAAgB,CAAC,OAAO,EAAE,UAACC,CAAC,EAAK;QACpDA,CAAC,CAACC,cAAc,CAAC;QACjBb,aAAa,CAACU,CAAC,CAACI,OAAO,CAACZ,MAAM;MAChC,CAAC,CAAC;IAAA;IACF,IAAMM,IAAG,GAAID,QAAQ,CAACC,IAAI,CAACO,OAAO,CAAC,GAAG,EAAC,EAAE;IACzC,IAAIP,IAAI,EAAE;MACR,IAAI,CAACtB,MAAK,GAAIsB,IAAG;MACjBR,aAAa,CAACQ,IAAI;IACpB;EACF;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}