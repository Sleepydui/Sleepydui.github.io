{"ast":null,"code":"import \"core-js/modules/es.object.to-string.js\";\nimport \"core-js/modules/es.string.iterator.js\";\nimport \"core-js/modules/web.dom-collections.iterator.js\";\nimport \"core-js/modules/web.url.js\";\nimport \"core-js/modules/web.url-search-params.js\";\nimport \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nexport default {\n  name: 'Content',\n  data: function data() {\n    return {\n      photoUrl: ''\n    };\n  },\n  mounted: function mounted() {\n    this.photoUrl = new URL('../../images/photo.jpeg', import.meta.url).href;\n  }\n};","map":{"version":3,"names":["name","data","photoUrl","mounted","URL","import","meta","url","href"],"sources":["/Users/a123/Desktop/个人网站/Sleepydui.github.io/src/components/Content.vue"],"sourcesContent":["<template>\n  <section class=\"right-col\">\n    <div class=\"panel\" id=\"about\">\n      <h2 class=\"section-title\">About Me</h2>\n      <p>\n        Hello! I am Xinyue Chen, a fourth-year PhD candidate in the School of Intelligence Science and Technology at Peking University, advised by Prof. Xiaoru Yuan in the <a href=\"http://vis.pku.edu.cn/\">PKUVIS Group</a>.\n      </p>\n      <p>\n        My research interests include <strong>Data Visualization, Human-Computer Interaction, and Computational Social Science</strong>. Specifically, I am fascinated by visualization as both a mode of knowledge production and a medium of expression. On the one hand, I leverage human-AI interfaces and visual analytics techniques to support domain experts in gaining insights, while also exploring new forms of human-computer interaction and interdisciplinary visualization literacy. On the other hand, I am curious about how visualization and AI agents can reshape our understanding of the real world and the processes of information dissemination. Recently, my primary focus has been on large-scale image data visualization and interdisciplinary human-AI interaction.\n      </p>\n      <p>\n        Beyond academia, I am also an independent developer, data journalist, and data handicraftsman. I create data-driven, generative, and interactive art.\n      </p>\n      <p>\n        Wandering through The Garden of Forking Paths, I write lines of data poetry.\n      </p>\n    </div>\n\n    <div class=\"panel\" id=\"news\">\n      <h2 class=\"section-title\">News</h2>\n      <ul class=\"news-list\">\n        <li><span class=\"leaf\" aria-hidden=\"true\">🎉</span> [04/2025] Our paper \"VisTaxa: Developing a Taxonomy of Historical Visualizations\"  is accepted by IEEE PacificVis TVCG track and received 🏆 Best Paper Honorable Mention.</li>\n        <li><span class=\"leaf\" aria-hidden=\"true\">🎨</span> [03/2025] Our program City Pulse is longlisted in the Information is Beautiful Awards 2024.</li>\n        <li><span class=\"leaf\" aria-hidden=\"true\">🎉</span> [08/2024] Our paper \"City Pulse: Revealing City Identity Through Abstraction of Metro Lines\" is accepted by IEEE VIS 2024 Arts Program as a pictorial.</li>\n        <li><span class=\"leaf\" aria-hidden=\"true\">🎉</span> [07/2024] Our paper \"Visual Analysis of Complex Temporal Networks Supported by Analytic Provenance\" is accepted by IEEE VAST Challenge 2024 MC3 and received 🏆 Honorable mention solution.</li>\n        <li><span class=\"leaf\" aria-hidden=\"true\">🎨</span> [06/2024] Our program City Pulse is to be exhibited in China VISAP'24. </li>\n        <li><span class=\"leaf\" aria-hidden=\"true\">🎨</span> </li>\n        <li><span class=\"leaf\" aria-hidden=\"true\">🌿</span> [06/2024] City Pulse is to be exhibited in China VISAP'24.</li>\n        <li><span class=\"leaf\" aria-hidden=\"true\">🌿</span> [04/2024] City Pulse is shortlisted in Visual Data Storytelling contest, PacificVis 2024.</li>\n        <li><span class=\"leaf\" aria-hidden=\"true\">🌿</span> [01/2024] EmoGeoCity is accepted by PacificVis 2024.</li>\n      </ul>\n    </div>\n\n    <div class=\"panel\" id=\"publications\">\n      <h2 class=\"section-title\" style=\"margin-top:0\">Publications</h2>\n      <section class=\"pubs\">\n        <article class=\"pub-item\">\n          <a class=\"pub-thumb\" href=\"#\" aria-label=\"thumbnail\"><img :src=\"photoUrl\" alt=\"thumbnail\" /></a>\n          <div class=\"pub-body\">\n            <div class=\"pub-badges\"><span class=\"badge badge-yellow\">Vis Survey</span></div>\n            <h3 class=\"pub-title\">\"Mapping What I Feel\": Understanding Affective Geovisualization Design Through the Lens of People-Place Relationships</h3>\n            <p class=\"pub-meta\">Xingyu Lan*, <strong>Yutong Yang*</strong>, Yifan Wang · IEEE VIS 2025</p>\n            <p class=\"pub-abstract\">We analyzed a corpus of affective geovisualization designs and constructed a taxonomy that characterizes their design features by referring to the PPP model from humanistic geography.</p>\n            <p class=\"pub-links\"><a href=\"#\">[Paper]</a><a href=\"#\">[Website]</a></p>\n          </div>\n        </article>\n\n        <article class=\"pub-item\">\n          <a class=\"pub-thumb\" href=\"#\" aria-label=\"thumbnail\"><img :src=\"photoUrl\" alt=\"thumbnail\" /></a>\n          <div class=\"pub-body\">\n            <div class=\"pub-badges\"><span class=\"badge badge-blue\">Data Art</span></div>\n            <h3 class=\"pub-title\">City Pulse: Revealing City Identity Through Abstraction of Metro Lines</h3>\n            <p class=\"pub-meta\">Xinyue Chen, Yixuan Zhang, <strong>Yutong Yang</strong>, ... · IEEE VIS 2024 Arts Program; PacificVis 2024 Visual Data Storytelling Contest</p>\n            <p class=\"pub-abstract\">We reveal the region characteristics and tell the story about the development of metro by abstracting the city as a square, the metro route as a line, and using the width of the lines to represent the coverage of the routes.</p>\n            <p class=\"pub-links\"><a href=\"#\">[Paper]</a><a href=\"#\">[System]</a><a href=\"#\">[Video]</a><a href=\"#\">[Gallery]</a></p>\n          </div>\n        </article>\n\n        <article class=\"pub-item\">\n          <a class=\"pub-thumb\" href=\"#\" aria-label=\"thumbnail\"><img :src=\"photoUrl\" alt=\"thumbnail\" /></a>\n          <div class=\"pub-body\">\n            <div class=\"pub-badges\"><span class=\"badge badge-green\">Vis Application</span></div>\n            <h3 class=\"pub-title\">EmoGeoCity: Interactive Visual Exploration of City's Historical and Cultural Evolution Based on Emotional Geography</h3>\n            <p class=\"pub-meta\"><strong>Yutong Yang</strong>, Yinou Liu, Qishuo Bai, Tianyi Zhou, Ziduo Ye, Xiaoju Dong · IEEE PacificVis 2024</p>\n            <p class=\"pub-abstract\">EmoGeoCity is a digital humanities visual analytics system to study a city's cultural and historical evolution, connecting multidimensional data with emotion.</p>\n            <p class=\"pub-links\"><a href=\"#\">[Paper]</a></p>\n          </div>\n        </article>\n      </section>\n    </div>\n\n    <div class=\"panel\" id=\"projects\">\n      <h2 class=\"section-title\" style=\"margin-top:0\">Projects</h2>\n      <section class=\"pubs projects\">\n        <article class=\"pub-item\">\n          <a class=\"pub-thumb\" href=\"#\" aria-label=\"thumbnail\"><img :src=\"photoUrl\" alt=\"thumbnail\" /></a>\n          <div class=\"pub-body\">\n            <div class=\"pub-badges\"><span class=\"badge badge-purple\">Project</span></div>\n            <h3 class=\"pub-title\">Octopus Maps: Visualizing Multi-Branch Metro Extensions Over Time</h3>\n            <p class=\"pub-meta\">Role: Design & Development · 2025</p>\n            <p class=\"pub-abstract\">An interactive map that presents metro expansion with multi-branch timelines and station narratives, optimized for storytelling and exploration.</p>\n            <p class=\"pub-links\"><a href=\"#\">[Demo]</a><a href=\"#\">[Code]</a></p>\n          </div>\n        </article>\n\n        <article class=\"pub-item\">\n          <a class=\"pub-thumb\" href=\"#\" aria-label=\"thumbnail\"><img :src=\"photoUrl\" alt=\"thumbnail\" /></a>\n          <div class=\"pub-body\">\n            <div class=\"pub-badges\"><span class=\"badge badge-purple\">Project</span></div>\n            <h3 class=\"pub-title\">City Stories: Human-centered Narratives from Urban Data</h3>\n            <p class=\"pub-meta\">Role: Research & Visualization · 2024</p>\n            <p class=\"pub-abstract\">A web experience combining qualitative accounts and quantitative signals to surface diverse city experiences and perspectives.</p>\n            <p class=\"pub-links\"><a href=\"#\">[Website]</a><a href=\"#\">[Report]</a></p>\n          </div>\n        </article>\n      </section>\n    </div>\n  </section>\n</template>\n\n<script>\nexport default {\n  name: 'Content',\n  data () {\n    return { photoUrl: '' }\n  },\n  mounted() {\n    this.photoUrl = new URL('../../images/photo.jpeg', import.meta.url).href\n  }\n}\n</script>\n\n<style>\n.right-col { align-self: start; max-width: none; overflow: auto; }\n.panel { scroll-margin-top: var(--header-offset); }\n.panel + .panel { margin-top: 1.25rem; }\n.section-title { font-family: \"Merriweather\", Georgia, serif; font-weight: 700; font-size: 1.375rem; margin: 0 0 0.625rem; }\n.interest-tags { margin-top: 0.625rem; color: var(--muted); }\n.interest-tags .label { color: var(--text); font-weight: 600; }\n.news-list { list-style: none; padding: 0; margin: 0.625rem 0 0 0; }\n.news-list li { padding-left: 0; margin: 0.15rem 0; }\n.news-list .leaf { margin-right: 0.375rem; }\n.site-footer { height: 5rem; }\n.pubs { margin-top: 0.5rem; }\n.pub-item { display: grid; grid-template-columns: 16.25rem 1fr; gap: 0.75rem; padding: 0.5rem 0; }\n.pub-item + .pub-item { margin-top: 1.25rem; }\n.pub-thumb img { display: block; width: 100%; height: auto; border: 0.0625rem solid var(--rule); }\n.pub-badges { margin: 0 0 0.125rem; }\n.badge { display: inline-block; font-size: 0.6875rem; padding: 0.0625rem 0.375rem; border-radius: 0.375rem; font-weight: 600; margin-right: 0.375rem; }\n.badge-yellow { background: #ffeab6; }\n.badge-blue { background: #d7ecff; }\n.badge-green { background: #dff6d8; }\n.badge-purple { background: #efe0ff; }\n.pub-title { font-family: \"Merriweather\", Georgia, serif; font-size: 0.875rem; margin: 0 0 0.125rem; }\n.pub-meta { margin: 0 0 0.125rem; color: var(--muted); font-size: 0.875rem; line-height: 1.4; }\n.pub-abstract { font-style: italic; color: var(--muted); margin: 0 0 0.125rem; font-size: 0.875rem; line-height: 1.4; }\n.pub-links a { margin-right: 0.375rem; font-size: 0.875rem; }\n\n@media (max-width: 48rem) {\n  .pub-item { grid-template-columns: 1fr; }\n}\n</style>\n\n\n"],"mappings":";;;;;;;;AAqGA,eAAe;EACbA,IAAI,EAAE,SAAS;EACfC,IAAG,WAAAA,KAAA,EAAK;IACN,OAAO;MAAEC,QAAQ,EAAE;IAAG;EACxB,CAAC;EACDC,OAAO,WAAAA,QAAA,EAAG;IACR,IAAI,CAACD,QAAO,GAAI,IAAIE,GAAG,CAAC,yBAAyB,EAAEC,MAAM,CAACC,IAAI,CAACC,GAAG,CAAC,CAACC,IAAG;EACzE;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}