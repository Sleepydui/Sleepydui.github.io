{"ast":null,"code":"import \"core-js/modules/es.array.for-each.js\";\nimport \"core-js/modules/es.array.from.js\";\nimport \"core-js/modules/es.object.to-string.js\";\nimport \"core-js/modules/es.regexp.exec.js\";\nimport \"core-js/modules/es.string.iterator.js\";\nimport \"core-js/modules/es.string.replace.js\";\nimport \"core-js/modules/web.dom-collections.for-each.js\";\nimport \"core-js/modules/web.dom-collections.iterator.js\";\nimport \"core-js/modules/web.url.js\";\nimport \"core-js/modules/web.url-search-params.js\";\nimport \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nexport default {\n  name: 'HomeView',\n  data: function data() {\n    return {\n      active: 'about',\n      logoUrl: '',\n      photoUrl: ''\n    };\n  },\n  mounted: function mounted() {\n    var _this = this;\n    this.logoUrl = new URL('@/assets/logo.png', import.meta.url).href;\n    this.photoUrl = new URL('../../images/photo.jpeg', import.meta.url).href;\n    var links = Array.from(document.querySelectorAll('.nav-link'));\n    var scrollToPanel = function scrollToPanel(id) {\n      var target = document.getElementById(id);\n      if (!target) return;\n      target.scrollIntoView({\n        behavior: 'smooth',\n        block: 'start'\n      });\n      _this.active = id;\n      location.hash = id;\n    };\n    links.forEach(function (a) {\n      return a.addEventListener('click', function (e) {\n        e.preventDefault();\n        scrollToPanel(a.dataset.target);\n      });\n    });\n    var hash = location.hash.replace('#', '');\n    if (hash) {\n      this.active = hash;\n      scrollToPanel(hash);\n    }\n  }\n};","map":{"version":3,"names":["name","data","active","logoUrl","photoUrl","mounted","_this","URL","import","meta","url","href","links","Array","from","document","querySelectorAll","scrollToPanel","id","target","getElementById","scrollIntoView","behavior","block","location","hash","forEach","a","addEventListener","e","preventDefault","dataset","replace"],"sources":["/Users/a123/Desktop/个人网站/Sleepydui.github.io/src/views/HomeView.vue"],"sourcesContent":["<template>\n  <div>\n    <header class=\"site-header\">\n      <div class=\"container header-inner\">\n        <img class=\"site-logo\" :src=\"logoUrl\" alt=\"logo\" />\n        <nav class=\"site-nav\" aria-label=\"Primary\">\n          <ul>\n            <li><a href=\"#about\" class=\"nav-link\" data-target=\"about\" :aria-selected=\"active === 'about'\">About Me</a></li>\n            <li><a href=\"#news\" class=\"nav-link\" data-target=\"news\" :aria-selected=\"active === 'news'\">News</a></li>\n            <li><a href=\"#publications\" class=\"nav-link\" data-target=\"publications\" :aria-selected=\"active === 'publications'\">Publications</a></li>\n            <li><a href=\"#projects\" class=\"nav-link\" data-target=\"projects\" :aria-selected=\"active === 'projects'\">Projects</a></li>\n          </ul>\n        </nav>\n      </div>\n    </header>\n\n    <main class=\"container layout\">\n      <section class=\"left-col\">\n        <figure class=\"hero-photo\"><img :src=\"photoUrl\" alt=\"Portrait under a tree\" /></figure>\n        <div class=\"profile-card\">\n          <p class=\"name\">Xinyue Chen</p>\n          <p class=\"affiliation\">Peking University</p>\n          <p class=\"email\">flora20@sjtu.edu.cn</p>\n        </div>\n      </section>\n\n      <section class=\"right-col\">\n        <div class=\"panel\" id=\"about\">\n          <h2 class=\"section-title\">About Me</h2>\n          <p>\n            Hi! I am a third-year master student in the <a href=\"#\">Data Intelligence Visual Analytics Team</a> at Shanghai Jiao Tong University and also a visiting student in <a href=\"#\">PKU Visualization and Visual Analytics Group</a> at Peking University, supervised by <a href=\"#\">Prof. Xiaojun Dong</a> and <a href=\"#\">Prof. Xiaoru Yuan</a>. Now, I am working in <a href=\"#\">SWAC, OECD</a> as a data analyst intern.\n          </p>\n          <p>\n            My research interests lie <strong>at the intersection of data visualization, humanities and social sciences</strong>. I'm passionate about using technology and creativity to delve into the humanities, and reflecting on the technology itself. It’s a pursuit fueled by a deep sense of empathy and a commitment to fairness. For me, an ideal work, even if it's a small force, should be truly valuable in enhancing mutual understanding and inclusivity among diverse individuals or societal groups. This might involve exploring individual differences impacting communication, revealing diverse life situations and perceptions, uncovering and presenting inequities, or advancing universal access to knowledge.\n          </p>\n          <p>\n            Additionally, I’m fascinated with the potential power of AI and look forward to exploring how human imagination can collaborate with it.\n          </p>\n          <p>\n            I enjoy reading, thinking, creating and also chatting with GPT. 😊\n          </p>\n          <p class=\"interest-tags\"><span class=\"label\">Interest Tags — </span> Interdiscipline, Data Humanism, Data Art, Subjectivity in Data Visualization, Affective Visualization Design, Visual Representation for Human, Social Science, Ethics, Reflections on InfoVis, Digital Humanities</p>\n        </div>\n\n        <div class=\"panel\" id=\"news\">\n          <h2 class=\"section-title\">News</h2>\n          <ul class=\"news-list\">\n            <li><span class=\"leaf\" aria-hidden=\"true\">🌿</span> [07/2025] Affective GeoVisualization Design is accepted by IEEE VIS 2025.</li>\n            <li><span class=\"leaf\" aria-hidden=\"true\">🌿</span> [07/2025] Octopus Maps Design is accepted by IEEE VIS 2025.</li>\n            <li><span class=\"leaf\" aria-hidden=\"true\">🌿</span> [03/2025] City Pulse is longlisted in the Information is Beautiful Awards 2024.</li>\n            <li><span class=\"leaf\" aria-hidden=\"true\">🌿</span> [03/2025] LearnClusterVis is accepted by EuroVis 2025 Education Papers track.</li>\n            <li><span class=\"leaf\" aria-hidden=\"true\">🌿</span> [03/2025] Dialogue Character Extraction and Attribution in Classic Chinese Novels is accepted by DH2025.</li>\n            <li><span class=\"leaf\" aria-hidden=\"true\">🌿</span> [08/2024] City Pulse is accepted by IEEE VIS 2024 Arts Program as a pictorial!</li>\n            <li><span class=\"leaf\" aria-hidden=\"true\">🌿</span> [07/2024] LearnClusterVis wins first prize in ChinaVis 2024 Visual Analytics Challenge.</li>\n            <li><span class=\"leaf\" aria-hidden=\"true\">🌿</span> [06/2024] City Pulse is to be exhibited in China VISAP'24.</li>\n            <li><span class=\"leaf\" aria-hidden=\"true\">🌿</span> [04/2024] City Pulse is shortlisted in Visual Data Storytelling contest, PacificVis 2024.</li>\n            <li><span class=\"leaf\" aria-hidden=\"true\">🌿</span> [01/2024] EmoGeoCity is accepted by PacificVis 2024.</li>\n          </ul>\n        </div>\n\n        <div class=\"panel\" id=\"publications\">\n          <h2 class=\"section-title\" style=\"margin-top:0\">Publications</h2>\n          <section class=\"pubs\">\n            <article class=\"pub-item\">\n              <a class=\"pub-thumb\" href=\"#\" aria-label=\"thumbnail\"><img :src=\"photoUrl\" alt=\"thumbnail\" /></a>\n              <div class=\"pub-body\">\n                <div class=\"pub-badges\"><span class=\"badge badge-yellow\">Vis Survey</span></div>\n                <h3 class=\"pub-title\">\"Mapping What I Feel\": Understanding Affective Geovisualization Design Through the Lens of People-Place Relationships</h3>\n                <p class=\"pub-meta\">Xingyu Lan*, <strong>Yutong Yang*</strong>, Yifan Wang · IEEE VIS 2025</p>\n                <p class=\"pub-abstract\">We analyzed a corpus of affective geovisualization designs and constructed a taxonomy that characterizes their design features by referring to the PPP model from humanistic geography.</p>\n                <p class=\"pub-links\"><a href=\"#\">[Paper]</a><a href=\"#\">[Website]</a></p>\n              </div>\n            </article>\n\n            <article class=\"pub-item\">\n              <a class=\"pub-thumb\" href=\"#\" aria-label=\"thumbnail\"><img :src=\"photoUrl\" alt=\"thumbnail\" /></a>\n              <div class=\"pub-body\">\n                <div class=\"pub-badges\"><span class=\"badge badge-blue\">Data Art</span></div>\n                <h3 class=\"pub-title\">City Pulse: Revealing City Identity Through Abstraction of Metro Lines</h3>\n                <p class=\"pub-meta\">Xinyue Chen, Yixuan Zhang, <strong>Yutong Yang</strong>, ... · IEEE VIS 2024 Arts Program; PacificVis 2024 Visual Data Storytelling Contest</p>\n                <p class=\"pub-abstract\">We reveal the region characteristics and tell the story about the development of metro by abstracting the city as a square, the metro route as a line, and using the width of the lines to represent the coverage of the routes.</p>\n                <p class=\"pub-links\"><a href=\"#\">[Paper]</a><a href=\"#\">[System]</a><a href=\"#\">[Video]</a><a href=\"#\">[Gallery]</a></p>\n              </div>\n            </article>\n\n            <article class=\"pub-item\">\n              <a class=\"pub-thumb\" href=\"#\" aria-label=\"thumbnail\"><img :src=\"photoUrl\" alt=\"thumbnail\" /></a>\n              <div class=\"pub-body\">\n                <div class=\"pub-badges\"><span class=\"badge badge-green\">Vis Application</span></div>\n                <h3 class=\"pub-title\">EmoGeoCity: Interactive Visual Exploration of City's Historical and Cultural Evolution Based on Emotional Geography</h3>\n                <p class=\"pub-meta\"><strong>Yutong Yang</strong>, Yinou Liu, Qishuo Bai, Tianyi Zhou, Ziduo Ye, Xiaoju Dong · IEEE PacificVis 2024</p>\n                <p class=\"pub-abstract\">EmoGeoCity is a digital humanities visual analytics system to study a city's cultural and historical evolution, connecting multidimensional data with emotion.</p>\n                <p class=\"pub-links\"><a href=\"#\">[Paper]</a></p>\n              </div>\n            </article>\n          </section>\n        </div>\n\n        <div class=\"panel\" id=\"projects\">\n          <h2 class=\"section-title\" style=\"margin-top:0\">Projects</h2>\n          <section class=\"pubs projects\">\n            <article class=\"pub-item\">\n              <a class=\"pub-thumb\" href=\"#\" aria-label=\"thumbnail\"><img src=\"/photo.jpeg\" alt=\"thumbnail\" /></a>\n              <div class=\"pub-body\">\n                <div class=\"pub-badges\"><span class=\"badge badge-purple\">Project</span></div>\n                <h3 class=\"pub-title\">Octopus Maps: Visualizing Multi-Branch Metro Extensions Over Time</h3>\n                <p class=\"pub-meta\">Role: Design & Development · 2025</p>\n                <p class=\"pub-abstract\">An interactive map that presents metro expansion with multi-branch timelines and station narratives, optimized for storytelling and exploration.</p>\n                <p class=\"pub-links\"><a href=\"#\">[Demo]</a><a href=\"#\">[Code]</a></p>\n              </div>\n            </article>\n\n            <article class=\"pub-item\">\n              <a class=\"pub-thumb\" href=\"#\" aria-label=\"thumbnail\"><img src=\"/photo.jpeg\" alt=\"thumbnail\" /></a>\n              <div class=\"pub-body\">\n                <div class=\"pub-badges\"><span class=\"badge badge-purple\">Project</span></div>\n                <h3 class=\"pub-title\">City Stories: Human-centered Narratives from Urban Data</h3>\n                <p class=\"pub-meta\">Role: Research & Visualization · 2024</p>\n                <p class=\"pub-abstract\">A web experience combining qualitative accounts and quantitative signals to surface diverse city experiences and perspectives.</p>\n                <p class=\"pub-links\"><a href=\"#\">[Website]</a><a href=\"#\">[Report]</a></p>\n              </div>\n            </article>\n          </section>\n        </div>\n      </section>\n    </main>\n\n    <footer class=\"site-footer\" aria-hidden=\"true\"></footer>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'HomeView',\n  data () {\n    return { active: 'about', logoUrl: '', photoUrl: '' }\n  },\n  mounted() {\n    this.logoUrl = new URL('@/assets/logo.png', import.meta.url).href\n    this.photoUrl = new URL('../../images/photo.jpeg', import.meta.url).href\n    const links = Array.from(document.querySelectorAll('.nav-link'))\n    const scrollToPanel = (id) => {\n      const target = document.getElementById(id)\n      if (!target) return\n      target.scrollIntoView({ behavior: 'smooth', block: 'start' })\n      this.active = id\n      location.hash = id\n    }\n    links.forEach(a => a.addEventListener('click', (e) => {\n      e.preventDefault()\n      scrollToPanel(a.dataset.target)\n    }))\n    const hash = location.hash.replace('#','')\n    if (hash) {\n      this.active = hash\n      scrollToPanel(hash)\n    }\n  }\n}\n</script>\n<style>\n/* Header */\n.site-header {\n  border-bottom: 0.0625rem solid var(--rule);\n  position: sticky;\n  top: 0;\n  background: #fff;\n  z-index: 10;\n}\n.header-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding-top: 1.125rem;\n  padding-bottom: 0.625rem;\n}\n.site-logo { height: 2.875rem; width: auto; display: block; }\n.site-nav ul { margin: 0; padding: 0; list-style: none; display: flex; gap: 1.75rem; }\n.site-nav a { font-family: \"Merriweather\", Georgia, serif; font-weight: 400; color: hsl(0 0% 27%); font-size: 1.125rem; }\n.site-nav a[aria-selected=\"true\"] { color: #000; }\n\n/* Layout */\n.layout {\n  display: grid;\n  grid-template-columns: calc(30% - 1% ) calc(70% - 1%);\n  gap: 2%;\n  padding-top: 2.25rem;\n  padding-bottom: 4rem;\n}\n\n/* Left */\n.left-col { position: sticky; top: 1.5rem; align-self: start; }\n.hero-photo { margin: 0.625rem 0 0 0; }\n.hero-photo img { display: block; width: 100%; height: auto; border: 0.0625rem solid var(--rule); box-sizing: border-box; }\n.profile-card { text-align: left; margin-top: 1.375rem; }\n.profile-card .name { font-family: \"Merriweather\", Georgia, serif; margin: 0 0 0.5rem 0; font-size: 1.25rem; }\n.profile-card .affiliation, .profile-card .email { margin: 0.375rem 0; color: var(--muted); }\n\n/* Right */\n.right-col { align-self: start; max-width: none; }\n.section-title { font-family: \"Merriweather\", Georgia, serif; font-weight: 700; font-size: 1.375rem; margin: 0 0 0.625rem; }\n.interest-tags { margin-top: 0.625rem; color: var(--muted); }\n.interest-tags .label { color: var(--text); font-weight: 600; }\n\n.news-list { list-style: none; padding: 0; margin: 0.625rem 0 0 0; }\n.news-list li { padding-left: 0; margin: 0.5rem 0; }\n.news-list .leaf { margin-right: 0.375rem; }\n\n.site-footer { height: 5rem; }\n\n/* Publications */\n.pubs { margin-top: 0.5rem; }\n.pub-item { display: grid; grid-template-columns: 16.25rem 1fr; gap: 0.75rem; padding: 0.5rem 0; }\n.pub-item + .pub-item { margin-top: 1.25rem; }\n.pub-thumb img { display: block; width: 100%; height: auto; border: 0.0625rem solid var(--rule); }\n.pub-badges { margin: 0 0 0.125rem; }\n.badge { display: inline-block; font-size: 0.6875rem; padding: 0.0625rem 0.375rem; border-radius: 0.375rem; font-weight: 600; margin-right: 0.375rem; }\n.badge-yellow { background: #ffeab6; }\n.badge-blue { background: #d7ecff; }\n.badge-green { background: #dff6d8; }\n.badge-purple { background: #efe0ff; }\n.pub-title { font-family: \"Merriweather\", Georgia, serif; font-size: 0.875rem; margin: 0 0 0.125rem; }\n.pub-meta { margin: 0 0 0.125rem; color: var(--muted); font-size: 0.875rem; line-height: 1.4; }\n.pub-abstract { font-style: italic; color: var(--muted); margin: 0 0 0.125rem; font-size: 0.875rem; line-height: 1.4; }\n.pub-links a { margin-right: 0.375rem; font-size: 0.875rem; }\n\n/* Responsive */\n@media (max-width: 48rem) {\n  .layout { grid-template-columns: 1fr; gap: 2rem; }\n  .header-inner { flex-direction: column; gap: 1rem; }\n  .site-nav ul { flex-wrap: wrap; justify-content: center; gap: 1rem; }\n}\n</style>\n"],"mappings":";;;;;;;;;;;;;AAoIA,eAAe;EACbA,IAAI,EAAE,UAAU;EAChBC,IAAG,WAAAA,KAAA,EAAK;IACN,OAAO;MAAEC,MAAM,EAAE,OAAO;MAAEC,OAAO,EAAE,EAAE;MAAEC,QAAQ,EAAE;IAAG;EACtD,CAAC;EACDC,OAAO,WAAAA,QAAA,EAAG;IAAA,IAAAC,KAAA;IACR,IAAI,CAACH,OAAM,GAAI,IAAII,GAAG,CAAC,mBAAmB,EAAEC,MAAM,CAACC,IAAI,CAACC,GAAG,CAAC,CAACC,IAAG;IAChE,IAAI,CAACP,QAAO,GAAI,IAAIG,GAAG,CAAC,yBAAyB,EAAEC,MAAM,CAACC,IAAI,CAACC,GAAG,CAAC,CAACC,IAAG;IACvE,IAAMC,KAAI,GAAIC,KAAK,CAACC,IAAI,CAACC,QAAQ,CAACC,gBAAgB,CAAC,WAAW,CAAC;IAC/D,IAAMC,aAAY,GAAI,SAAhBA,aAAYA,CAAKC,EAAE,EAAK;MAC5B,IAAMC,MAAK,GAAIJ,QAAQ,CAACK,cAAc,CAACF,EAAE;MACzC,IAAI,CAACC,MAAM,EAAE;MACbA,MAAM,CAACE,cAAc,CAAC;QAAEC,QAAQ,EAAE,QAAQ;QAAEC,KAAK,EAAE;MAAQ,CAAC;MAC5DjB,KAAI,CAACJ,MAAK,GAAIgB,EAAC;MACfM,QAAQ,CAACC,IAAG,GAAIP,EAAC;IACnB;IACAN,KAAK,CAACc,OAAO,CAAC,UAAAC,CAAA;MAAA,OAAKA,CAAC,CAACC,gBAAgB,CAAC,OAAO,EAAE,UAACC,CAAC,EAAK;QACpDA,CAAC,CAACC,cAAc,CAAC;QACjBb,aAAa,CAACU,CAAC,CAACI,OAAO,CAACZ,MAAM;MAChC,CAAC,CAAC;IAAA;IACF,IAAMM,IAAG,GAAID,QAAQ,CAACC,IAAI,CAACO,OAAO,CAAC,GAAG,EAAC,EAAE;IACzC,IAAIP,IAAI,EAAE;MACR,IAAI,CAACvB,MAAK,GAAIuB,IAAG;MACjBR,aAAa,CAACQ,IAAI;IACpB;EACF;AACF"},"metadata":{},"sourceType":"module","externalDependencies":[]}