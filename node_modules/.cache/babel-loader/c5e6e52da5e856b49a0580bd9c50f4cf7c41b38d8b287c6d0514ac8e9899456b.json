{"ast":null,"code":"import \"core-js/modules/es.regexp.exec.js\";\nimport \"core-js/modules/es.string.replace.js\";\nimport Navigation from '@/components/Navigation.vue';\nimport Photo from '@/components/Photo.vue';\nimport Content from '@/components/Content.vue';\nexport default {\n  name: 'HomeView',\n  components: {\n    Navigation: Navigation,\n    Photo: Photo,\n    Content: Content\n  },\n  data: function data() {\n    return {\n      active: 'about'\n    };\n  },\n  mounted: function mounted() {\n    var _this = this;\n    var hash = location.hash.replace('#', '');\n    if (hash) {\n      this.active = hash;\n      this.$nextTick(function () {\n        return _this.scrollToPanel(hash, true);\n      });\n    }\n  },\n  methods: {\n    scrollToPanel: function scrollToPanel(id, skipHashUpdate) {\n      var target = document.getElementById(id);\n      if (!target) return;\n      var header = document.querySelector('.site-header');\n      var headerHeight = header ? header.getBoundingClientRect().height : 0;\n      var extraGap = 8; // 约等于0.5rem，避免标题贴边\n      var y = target.getBoundingClientRect().top + window.pageYOffset - headerHeight - extraGap;\n      window.scrollTo({\n        top: y,\n        behavior: 'smooth'\n      });\n      this.active = id;\n      // 不更新hash，避免路由误判为 /about 等路径\n    }\n  }\n};","map":{"version":3,"names":["Navigation","Photo","Content","name","components","data","active","mounted","_this","hash","location","replace","$nextTick","scrollToPanel","methods","id","skipHashUpdate","target","document","getElementById","header","querySelector","headerHeight","getBoundingClientRect","height","extraGap","y","top","window","pageYOffset","scrollTo","behavior"],"sources":["/Users/a123/Desktop/个人网站/Sleepydui.github.io/src/views/HomeView.vue"],"sourcesContent":["<template>\n  <div>\n    <Navigation :active=\"active\" @navigate=\"scrollToPanel\"/>\n    <main class=\"container layout\">\n      <Photo/>\n      <Content/>\n    </main>\n    <footer class=\"site-footer\" aria-hidden=\"true\"></footer>\n  </div>\n</template>\n\n<script>\nimport Navigation from '@/components/Navigation.vue'\nimport Photo from '@/components/Photo.vue'\nimport Content from '@/components/Content.vue'\n\nexport default {\n  name: 'HomeView',\n  components: { Navigation, Photo, Content },\n  data () { return { active: 'about' } },\n  mounted() {\n    const hash = location.hash.replace('#','')\n    if (hash) {\n      this.active = hash\n      this.$nextTick(() => this.scrollToPanel(hash, true))\n    }\n  },\n  methods: {\n    scrollToPanel(id, skipHashUpdate) {\n      const target = document.getElementById(id)\n      if (!target) return\n      const header = document.querySelector('.site-header')\n      const headerHeight = header ? header.getBoundingClientRect().height : 0\n      const extraGap = 8 // 约等于0.5rem，避免标题贴边\n      const y = target.getBoundingClientRect().top + window.pageYOffset - headerHeight - extraGap\n      window.scrollTo({ top: y, behavior: 'smooth' })\n      this.active = id\n      // 不更新hash，避免路由误判为 /about 等路径\n    }\n  }\n}\n</script>\n<style>\n.layout { display: grid; grid-template-columns: calc(30% - 1%) calc(70% - 1%); gap: 2%; padding-top: 2.25rem; padding-bottom: 4rem; }\n.site-footer { height: 5rem; }\n@media (max-width: 48rem) { .layout { grid-template-columns: 1fr; gap: 2rem; } }\n</style>\n"],"mappings":";;AAYA,OAAOA,UAAS,MAAO,6BAA4B;AACnD,OAAOC,KAAI,MAAO,wBAAuB;AACzC,OAAOC,OAAM,MAAO,0BAAyB;AAE7C,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEJ,UAAU,EAAVA,UAAU;IAAEC,KAAK,EAALA,KAAK;IAAEC,OAAM,EAANA;EAAQ,CAAC;EAC1CG,IAAG,WAAAA,KAAA,EAAK;IAAE,OAAO;MAAEC,MAAM,EAAE;IAAQ;EAAE,CAAC;EACtCC,OAAO,WAAAA,QAAA,EAAG;IAAA,IAAAC,KAAA;IACR,IAAMC,IAAG,GAAIC,QAAQ,CAACD,IAAI,CAACE,OAAO,CAAC,GAAG,EAAC,EAAE;IACzC,IAAIF,IAAI,EAAE;MACR,IAAI,CAACH,MAAK,GAAIG,IAAG;MACjB,IAAI,CAACG,SAAS,CAAC;QAAA,OAAMJ,KAAI,CAACK,aAAa,CAACJ,IAAI,EAAE,IAAI,CAAC;MAAA;IACrD;EACF,CAAC;EACDK,OAAO,EAAE;IACPD,aAAa,WAAAA,cAACE,EAAE,EAAEC,cAAc,EAAE;MAChC,IAAMC,MAA